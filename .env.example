# Warehouse target: duckdb (default local) or bigquery
WAREHOUSE_TARGET=duckdb
DUCKDB_PATH=data/municipal_capital.duckdb

# Optional Google Cloud / BigQuery / Vertex AI settings
GCP_PROJECT_ID=
GCP_LOCATION=us-central1
BQ_DATASET_RAW=raw_municipal
BQ_DATASET_STAGING=stg_municipal
BQ_DATASET_MARTS=marts_municipal
VERTEX_MODEL_NAME=gemini-2.5-flash

# Optional real open data run (1 = run real public data benchmark if cached/available)
REAL_DATA=1
